entrypoint = "index.js"
modules = ["nodejs-22"]
hidden = [".config", "package-lock.json"]

[gitHubImport]
requiredFiles = [".replit", "replit.nix", "package.json", "package-lock.json"]

[nix]
channel = "stable-24_11"
packages = ["unzip", "psmisc"]

[deployment]
run = ["node", "index.js"]
deploymentTarget = "autoscale"
ignorePorts = false

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "PropertyVision1 Dev Server"
author = 46702349
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd PropertyVision1 && npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "PropertyVision Server"

[[workflows.workflow]]
name = "PropertyVision Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd PropertyVision1 && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
expertMode = true
