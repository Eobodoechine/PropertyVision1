# === PropertyVision1 .env.example ===
# Copy this to .env and fill in real keys before running

# RapidAPI (Realtor) key (required)
RAPIDAPI_KEY=replace_me

# Google Maps (used for geocoding/place_id)
GOOGLE_MAPS_API_KEY=replace_me

# If you want to use a database with Drizzle (optional)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional: override server port (default 5000)
PORT=5000
